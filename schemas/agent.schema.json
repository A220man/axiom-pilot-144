{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cursor Agent Frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "description": "Agent identifier. Lowercase letters, numbers, and hyphens only. Must match the parent folder name."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Description of what the agent does."
    },
    "icon": {
      "type": "string",
      "description": "Icon identifier for UI display."
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Hex color code for UI display (e.g., #ff0000)."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Client-specific extra fields."
    }
  }
}

